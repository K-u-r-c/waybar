// ┌──────────────────────────────────────────────────────────────┐
// │  waybar :: terminal / monochrome theme                   │
// │  backup poprzedniej wersji: config.jsonc.pre-hacker.bak      │
// └──────────────────────────────────────────────────────────────┘
{
    "layer": "overlay",
    "exclusive": false,
    "passthrough": false,
    "position": "top",
    "height": 32,
    // "output" (główny monitor) generuje launch.sh
    "include": ["~/.cache/waybar/output.jsonc"],

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window",
        "custom/cursor"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "mpris",
        "pulseaudio",
        "tray"
    ],

    // ── LEFT ──────────────────────────────────────────────────────
    // numer pulpitu + ikony jego okien (jak pasek zadań w Windowsie); klik w ikonę = fokus na to okno
    "hyprland/workspaces": {
        "format": "{name} {windows}",
        "workspace-taskbar": {
            "enable": true,
            "format": "{icon}",
            "icon-size": 15,
            "on-click-window": "hyprctl dispatch focuswindow address:{address}",
            "ignore-list": ["^screensaver$"]
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },

    "hyprland/window": {
        "format": "<span color='#ffffff'>❯</span> {}",
        "max-length": 60,
        "separate-outputs": true
    },

    "custom/cursor": {
        "format": "█",
        "tooltip": false
    },

    // ── CENTER ────────────────────────────────────────────────────
    "clock": {
        "interval": 1,
        "format": "<span color='#5a5a5a'>[</span> {:%H:%M:%S} <span color='#5a5a5a'>]</span>",
        "format-alt": "<span color='#5a5a5a'>[</span> <span color='#ffffff'>{:%a %d.%m.%Y}</span> <span color='#5a5a5a'>::</span> {:%H:%M:%S} <span color='#5a5a5a'>]</span>",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#ffffff'><b>{}</b></span>",
                "weeks":    "<span color='#5a5a5a'>W{}</span>",
                "weekdays": "<span color='#a0a0a0'><b>{}</b></span>",
                "days":     "<span color='#a0a0a0'>{}</span>",
                "today":    "<span background='#ffffff' color='#000000'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // ── RIGHT ─────────────────────────────────────────────────────
    "mpris": {
        "format": "<span color='#ffffff'>{status_icon}</span> {title}",
        "format-paused": "<span color='#5a5a5a'>{status_icon} {title}</span>",
        "status-icons": { "playing": "▶", "paused": "⏸", "stopped": "■" },
        "max-length": 35,
        "tooltip-format": "{player}: {artist} — {title}\nLPM: play/pause | scroll: następny/poprzedni",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "<span color='#ffffff'>vol</span> <span color='#a0a0a0'>{icon}</span> {volume}%",
        "format-muted": "<span color='#ffffff'>vol [ muted ]</span>",
        "format-icons": {
            "default": ["░░░░░", "█░░░░", "██░░░", "███░░", "████░", "█████"]
        },
        "tooltip-format": "{desc}\nLPM: mute | PPM: pavucontrol | scroll: głośność",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    }
}
